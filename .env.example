# Copy to .env for local dev. Real secrets live in GCP Secret Manager in cloud envs.

NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=epl
DB_PASSWORD=epl
DB_NAME=epl_move

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379

# Pub/Sub emulator (docker-compose)
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=epl-move-local

# Auth (Phase 1) — RS256 keypair; in cloud these come from Secret Manager
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# Web app → gateway (apps/web-shipper). When unset, the SPA uses mock data.
VITE_API_URL=
