# EPL Move — Platform Admin Portal
# Copy to .env.local and fill in values before starting the app.

# Required: URL of the API Gateway (no trailing slash)
VITE_API_URL=https://api.epl-move.com

# Portal URLs (used by the portal switcher in the top bar)
VITE_PORTAL_SHIPPER_URL=https://app.epl-move.com
VITE_PORTAL_CARRIER_URL=https://carrier.epl-move.com
VITE_PORTAL_BROKER_URL=https://broker.epl-move.com
VITE_PORTAL_ADMIN_URL=https://admin.epl-move.com
